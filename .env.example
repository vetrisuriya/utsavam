# Public origin used for canonicals, Open Graph URLs, sitemap entries and share links.
# Example: https://utsavam.example
# On Vercel this is optional: VERCEL_PROJECT_PRODUCTION_URL and VERCEL_URL are used as fallbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional search-engine ownership tokens, rendered as verification meta tags.
# Google Search Console → Settings → Ownership verification → HTML tag (content only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Verify your site → Meta tag (content only).
NEXT_PUBLIC_BING_SITE_VERIFICATION=
